import numpy as np
import re
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, LSTM, Dense, Dropout
from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint
from tensorflow.keras.utils import to_categorical
import matplotlib.pyplot as plt

# -----------------------------
# 1. Load & Clean Text
# -----------------------------
def load_text(filename):
    with open(filename, "r", encoding="utf-8") as f:
        text = f.read()
    text = text.lower()
    text = re.sub(r"[^a-zA-Z\s]", "", text)
    return text

text = load_text("shakespeare.txt")
tokens = text.split()

# -----------------------------
# 2. Build Vocabulary
# -----------------------------
vocab = sorted(set(tokens))
vocab_size = len(vocab)

token_to_id = {w: i for i, w in enumerate(vocab)}
id_to_token = {i: w for w, i in token_to_id.items()}

# -----------------------------
# 3. Create Sequences
# -----------------------------
seq_length = 20
X, y = [], []

for i in range(seq_length, len(tokens)):
    seq = tokens[i-seq_length:i]       
    next_w = tokens[i]

    X.append([token_to_id[w] for w in seq])
    y.append(token_to_id[next_w])

X = np.array(X)
y = to_categorical(y, num_classes=vocab_size)

# Train/Validation split
split = int(0.8 * len(X))
X_train, X_val = X[:split], X[split:]
y_train, y_val = y[:split], y[split:]

print("Vocabulary size:", vocab_size)
print("Training sequences:", len(X_train))

# -----------------------------
# 4. Build LSTM Model (Updated)
# -----------------------------
def build_model(vocab_size, seq_length, embedding_dim=128, lstm_units=256):
    model = Sequential([
        Embedding(input_dim=vocab_size, output_dim=embedding_dim),
        LSTM(lstm_units, return_sequences=True),
        LSTM(lstm_units),
        Dense(128, activation='relu'),
        Dropout(0.2),
        Dense(vocab_size, activation='softmax')
    ])
    model.compile(loss='categorical_crossentropy', optimizer='adam', metrics=['accuracy'])
    return model

model = build_model(vocab_size, seq_length)

# IMPORTANT: Build the model once with fake input
model(np.zeros((1, seq_length)))
model.summary()

# -----------------------------
# 5. Train Model
# -----------------------------
callbacks = [
    EarlyStopping(monitor="val_loss", patience=3, restore_best_weights=True),
    ModelCheckpoint("best_lstm_model.h5", save_best_only=True)
]

history = model.fit(
    X_train, y_train,
    batch_size=128,
    epochs=30,
    validation_data=(X_val, y_val),
    callbacks=callbacks
)

# -----------------------------
# 6. Plot Training Curves
# -----------------------------
plt.plot(history.history["loss"], label="Training Loss")
plt.plot(history.history["val_loss"], label="Validation Loss")
plt.legend()
plt.show()

# -----------------------------
# 7. TEXT GENERATION
# -----------------------------
def generate_text(model, seed_text, max_words=50, temperature=0.7):
    words = seed_text.lower().split()

    for _ in range(max_words):
        input_words = words[-seq_length:]

        if len(input_words) < seq_length:
            input_words = [""]*(seq_length - len(input_words)) + input_words

        encoded = np.array([token_to_id.get(w, 0) for w in input_words]).reshape(1, seq_length)

        preds = model.predict(encoded, verbose=0)[0]
        preds = np.log(preds + 1e-8) / temperature
        preds = np.exp(preds) / np.sum(np.exp(preds))

        next_id = np.random.choice(len(preds), p=preds)
        next_word = id_to_token[next_id]

        words.append(next_word)

    return " ".join(words)

# -----------------------------
# 8. Generate Sample
# -----------------------------
print("\nGenerated Text:\n")
print(generate_text(model, "to be or not to be", 80))
